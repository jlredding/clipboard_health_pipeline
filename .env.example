# Copy to .env and fill in. .env is git-ignored. Load with: set -a; source .env; set +a
AWS_PROFILE=default
AWS_DEFAULT_REGION=us-east-2
RAW_DEST=s3://YOUR-BUCKET/clipboard

SNOWFLAKE_ACCOUNT=xxxxxxx-xxxxxxx
SNOWFLAKE_USER=PIPELINE_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/rsa_key.p8   # key-pair auth; never put the key in this folder
SNOWFLAKE_ROLE=CLIPBOARD_TRANSFORMER
SNOWFLAKE_WAREHOUSE=CLIPBOARD_WH

# dbt: dev = local DuckDB, prod = Snowflake
DBT_TARGET=dev
DBT_PROFILES_DIR=dbt/clipboard_health
